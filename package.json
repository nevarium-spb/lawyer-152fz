{
  "name": "lawyer-152fz",
  "private": true,
  "description": "ИИ-юрист по 152-ФЗ и работе с РКН: плагин Claude Code + MCP-сервер",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "node node_modules/tsc7/bin/tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm depcruise && pnpm kb:check && pnpm test:coverage && pnpm build:server && pnpm smoke:server && pnpm build:npm && pnpm smoke:npm",
    "changeset": "changeset",
    "kb:import": "tsx packages/knowledge/scripts/import-acts.ts",
    "kb:check": "tsx packages/knowledge/scripts/check-kb.ts",
    "build:server": "tsx packages/mcp-server/scripts/build-server.ts",
    "smoke:server": "tsx packages/mcp-server/scripts/smoke-server.ts",
    "build:npm": "tsx packages/mcp-server/scripts/build-npm.ts",
    "smoke:npm": "tsx packages/mcp-server/scripts/smoke-npm.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tsc7": "npm:typescript@7.0.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
