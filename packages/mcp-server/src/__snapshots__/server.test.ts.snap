              "type": "string",
            },
            "mediaRegister": {
              "description": "Раздел mediaRegister: бумажные и иные материальные носители, по одной записи на носитель одной цели. Всё называет пользователь: места, лиц и меры не придумывай",
              "items": {
                "properties": {
                  "accessPersons": {
                    "description": "Должности лиц, обрабатывающих данные или имеющих доступ",
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
