            "contactEmail": {
              "description": "E-mail для обращений субъектов персональных данных",
              "type": "string",
            },
            "crossBorderTransfers": {
              "description": "Обязательно. Трансграничные передачи: зарубежные сервисы аналитики, почты, CDN, форм. Пустой список [] — только если пользователь прямо подтвердил, что их нет",
              "items": {
                "properties": {
                  "assessmentDate": {
