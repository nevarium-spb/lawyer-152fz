                "destructionDate": {
                  "description": "Дата уничтожения персональных данных, ГГГГ-ММ-ДД",
                  "type": "string",
                },
                "media": {
                  "description": "Носители при обработке без средств автоматизации",
                  "items": {
                    "properties": {
                      "name": {
