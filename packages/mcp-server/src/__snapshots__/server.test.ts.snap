                "entries",
              ],
              "type": "object",
            },
            "acknowledgmentSheet": {
              "description": "Раздел acknowledgmentSheet: лист ознакомления работников (п. 6 ч. 1 ст. 18.1; при бумажной обработке — п. 6 ПП РФ № 687)",
              "properties": {
                "documents": {
                  "description": "Локальные акты, с которыми знакомятся работники, например «Положение об обработке персональных данных»; называет пользователь",
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
                "employees": {
                  "description": "Работники, только если назвал пользователь; без них лист выйдет с пустыми строками",
                  "items": {
                    "properties": {
                      "fullName": {
                        "description": "ФИО работника",
                        "type": "string",
                      },
                      "position": {
                        "description": "Должность",
                        "type": "string",
                      },
                    },
                    "type": "object",
                  },
                  "type": "array",
                },
              },
              "type": "object",
            },
            "consentTerm": {
              "description": "Раздел consent: срок действия согласия",
              "type": "string",
