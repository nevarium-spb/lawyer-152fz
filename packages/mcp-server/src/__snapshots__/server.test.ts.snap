                        "type": "string",
                      },
                      "sheets": {
                        "description": "Количество листов",
                        "type": "number",
                      },
                    },
                    "required": [
                      "sheets",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
                "method": {
                  "description": "Способ уничтожения",
                  "type": "string",
                },
                "processors": {
                  "description": "Лица, обрабатывавшие эти данные по поручению оператора; не передавай, если обработка не поручалась (подтверди у пользователя)",
                  "items": {
                    "properties": {
                      "address": {
                        "description": "Адрес",
                        "type": "string",
                      },
                      "name": {
                        "description": "Наименование или ФИО",
                        "type": "string",
                      },
                    },
                    "type": "object",
                  },
                  "type": "array",
                },
                "reason": {
                  "description": "Причина уничтожения",
                  "type": "string",
                },
                "subjects": {
                  "description": "ФИО субъектов или иная информация, относящаяся к определённым лицам, чьи данные уничтожены",
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
                "systems": {
                  "description": "Информационные системы, из которых уничтожены данные (с автоматизацией)",
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              },
