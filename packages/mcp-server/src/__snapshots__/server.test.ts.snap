                  "description": "Что произошло и какие данные затронуты",
                  "type": "string",
                },
                "discoveredAt": {
                  "description": "Дата и время выявления инцидента, например «2026-11-02 10:30»",
                  "type": "string",
                },
                "investigationResults": {
                  "description": "Результаты внутреннего расследования, только если они уже известны; иначе не передавай",
                  "type": "string",
                },
                "measuresTaken": {
                  "description": "Принятые меры по устранению последствий",
