              },
              "type": "array",
            },
            "databaseLocation": {
              "description": "Где находится база данных с персональными данными",
              "properties": {
                "address": {
                  "description": "Город и ЦОД или хостинг-провайдер",
                  "type": "string",
                },
                "country": {
                  "description": "Код страны ISO 3166-1, где база находится на самом деле. Шаблоны принимают только RU (ч. 5 ст. 18), но не подставляй RU, если пользователь этого не подтвердил",
                  "type": "string",
                },
              },
              "type": "object",
            },
            "destructionAct": {
              "description": "Раздел destructionAct: акт об уничтожении ПДн (приказ РКН № 179). Нужен хотя бы один носитель или одна система. Всё называет пользователь: не придумывай",
              "properties": {
                "dataCategories": {
