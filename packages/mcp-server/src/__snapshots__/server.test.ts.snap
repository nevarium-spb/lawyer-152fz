            "destructionProcedure": {
              "description": "Раздел destructionProcedure: порядок уничтожения ПДн (ст. 21 Закона, приказ РКН № 179). Исполнителей и способы называет пользователь: не придумывай",
              "properties": {
                "date": {
                  "description": "Дата утверждения, ГГГГ-ММ-ДД",
                  "type": "string",
