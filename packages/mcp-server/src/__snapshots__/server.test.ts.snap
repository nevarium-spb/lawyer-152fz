              "normRefs",
              "requires",
              "requiredFields",
            ],
            "type": "object",
          },
          "type": "array",
        },
      },
      "required": [
        "templates",
      ],
      "type": "object",
    },
    "title": "Шаблоны документов по 152-ФЗ",
  },
  {
    "_meta": undefined,
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Заполняет шаблон данными оператора и возвращает Markdown документа, предупреждения и дисклеймер отдельно от него. Если профиль неполный, перечисляет все недостающие поля разом — спросите их у пользователя одним сообщением. Сервер ничего не сохраняет: файл в проект пишет клиент с согласия пользователя. / Renders a template; lists all missing profile fields at once.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "profile": {
          "description": "Профиль оператора персональных данных",
          "properties": {
            "accessList": {
              "description": "Раздел accessList: перечень лиц, допущенных к данным в информационных системах (пп. «в» п. 13 ПП № 1119). Должности и обязанности называет пользователь: не придумывай",
              "properties": {
                "date": {
                  "description": "Дата утверждения, ГГГГ-ММ-ДД",
                  "type": "string",
                },
                "entries": {
                  "items": {
                    "properties": {
                      "dataCategories": {
                        "description": "Категории данных, к которым нужен доступ",
                        "items": {
                          "type": "string",
                        },
                        "type": "array",
                      },
                      "duties": {
                        "description": "Служебные обязанности, для которых нужен доступ",
                        "type": "string",
                      },
                      "position": {
                        "description": "Должность работника с доступом",
                        "type": "string",
                      },
                      "system": {
                        "description": "Информационная система",
                        "type": "string",
                      },
                    },
                    "type": "object",
                  },
                  "type": "array",
                },
                "number": {
                  "description": "Номер перечня (приказа)",
                  "type": "string",
                },
                "signatory": {
                  "properties": {
                    "fullName": {
                      "description": "ФИО руководителя оператора, утверждающего перечень",
                      "type": "string",
                    },
                    "position": {
                      "description": "Должность руководителя",
                      "type": "string",
                    },
                  },
                  "type": "object",
                },
              },
              "required": [
